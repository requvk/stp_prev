# Publish only the scripts needed to build, install and uninstall
/scripts/*
!/scripts/build.ps1
!/scripts/install.ps1
!/scripts/uninstall.ps1
!/scripts/setup.ps1
!/scripts/Install.cmd
!/scripts/Uninstall.cmd

